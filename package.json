{
  "name": "ai-eng-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "m1:t1": "node src/m1/task-1/toy-predictor.ts",
    "m1:t1:greedy": "node src/m1/task-1/toy-predictor.ts --greedy",
    "check": "tsc --noEmit",
    "m1:t2": "node --env-file-if-exists=.env src/m1/task-2/first-call.ts",
    "m1:t3:test": "node --test src/m1/task-3/*.test.ts",
    "m1:t3": "node --env-file-if-exists=.env src/m1/task-3/repeat.ts",
    "m1:t4:server": "node --env-file-if-exists=.env src/m1/task-4/server.ts",
    "m1:t4:load": "node src/m1/task-4/load.ts",
    "m2:t1": "node --env-file-if-exists=.env src/m2/task-1/forgetful.ts",
    "m2:t2": "node --env-file-if-exists=.env src/m2/task-2/chat.ts",
    "m2:t2:script": "node --env-file-if-exists=.env src/m2/task-2/chat.ts --script",
    "m2:t3:test": "node --test src/m2/task-3/*.test.ts",
    "m2:t3": "node --env-file-if-exists=.env src/m2/task-3/experiment.ts",
    "m2:t3:no-facts": "node --env-file-if-exists=.env src/m2/task-3/experiment.ts --no-facts",
    "m2:t4:server": "node --env-file-if-exists=.env src/m2/task-4/server.ts",
    "m2:t4:load": "node src/m2/task-4/load.ts",
    "m3:t1": "node --env-file-if-exists=.env src/m3/task-1/naive-json.ts",
    "m3:t2:test": "node --test src/m3/task-2/*.test.ts",
    "m3:t2": "node --env-file-if-exists=.env src/m3/task-2/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
